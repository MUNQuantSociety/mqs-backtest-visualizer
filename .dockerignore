# Include any files or directories that you don't want to be copied to your
# container here (e.g., local build artifacts, temporary files, etc.).
#
# For more help, visit the .dockerignore file reference guide at
# https://docs.docker.com/go/build-context-dockerignore/
#
# Unlike .gitignore, a bare `name/` here is anchored to the context root, so
# `data/` excludes the parquet cache without touching the vendored
# `engine/data/` package. Use `**/` only where every depth is meant.

**/.DS_Store
**/__pycache__
**/.venv
**/venv
**/.pytest_cache
**/.coverage
**/.classpath
**/.dockerignore
**/.env
**/.env.*
**/.git
**/.gitignore
**/.project
**/.settings
**/.toolstarget
**/.vs
**/.vscode
**/.idea
**/*.*proj.user
**/*.dbmdl
**/*.jfm
**/bin
**/charts
**/docker-compose*
**/compose.y*ml
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
**/.artifacts
**/.aws
**/.ssh
**/*.pem
**/*.key
**/*.tfstate*
**/.terraform
**/*.pyc
**/htmlcov

# Runtime state that must never ride along in an image: the parquet market-data
# cache is hundreds of MB and is rebuilt from the database, the local strategy
# store holds uploads that belong to a running instance, and .artifacts is
# backtest output written at runtime.
data/
.strategy_store/
.artifacts/

# Development-only trees. Nothing under src/, engine/ or server.py imports
# from them, and CI runs the tests from a checkout, not from the image.
tests/
docs/
.github/
scripts/
frontend/
dist/
build/
LICENSE
README.md
README.Docker.md
BACKEND_PLAN.md
mermaid-diagram.svg
