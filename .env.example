# =============================================================================
# MQS Backtest Visualizer — Backend environment template
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env
#
# Application settings are read by `src/core/config.py`; standalone engine
# data providers read their settings from this same file.
# =============================================================================

# Backtest prices and coverage. Blank defaults to FMP and requires FMP_API_KEY.
# Set database explicitly only to restore the legacy price source.
# FMP failures are reported; they never fall back to DB/demo prices.
MARKET_DATA_SOURCE=
FMP_API_KEY=


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=mqs-backtest-visualizer
APP_ENV=development                  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR

# Public path prefix. The frontend's VITE_API_BASE_URL is "/api"; changing this
# breaks the client.
API_PREFIX=/api

# Comma-separated origins allowed to call the API (the frontend dev servers).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Host and port are uvicorn command-line arguments, not settings:
#   uvicorn server:app --reload --port 8000


# -----------------------------------------------------------------------------
# PostgreSQL — one instance, two roles for it
# -----------------------------------------------------------------------------
# The MQS database. This application uses it for two distinct things:
#   1. READ  public.market_data          — OHLCV bars the engine simulates over
#   2. WRITE app.* (its own schema)      — runs, metrics, equity points, trades
# The app schema is created on first startup. The trading tables
# (positions_book, cash_equity_book, trade_execution_logs, ...) are NEVER
# touched — not read, not written. Enforced by code review until a dedicated
# restricted role exists.
POSTGRES_HOST=
POSTGRES_PORT=25060
POSTGRES_DB=mqsdb
POSTGRES_USER=
POSTGRES_PASSWORD=

# `require` is rejected by this server; `prefer` connects and still encrypts.
# Verified against the live instance — do not change without retesting.
POSTGRES_SSLMODE=prefer

# --- Local Docker database (README.Docker.md) --------------------------------
# `docker compose up -d db` serves the same schema on a throwaway container, so
# you can develop without VPN access to the warehouse and without sharing a host
# with the live trading system. To use it, replace the six values above with
# these. The bars in it are synthetic: good for exercising the pipeline, useless
# for judging a strategy.
#
#   POSTGRES_HOST=localhost
#   POSTGRES_PORT=5433
#   POSTGRES_DB=mqsdb
#   POSTGRES_USER=mqs
#   POSTGRES_PASSWORD=mqs_dev_password
#   POSTGRES_SSLMODE=disable
#
# `disable` rather than `prefer` because the container serves plaintext on a
# loopback port; the note above about `require` describes the remote instance.
# Running the API in compose instead of on the host? Use host `db` and port
# 5432 — compose.yaml already sets those on the `server` service.
# -----------------------------------------------------------------------------

# API-side connection pool. Deliberately small: workers open their own
# short-lived synchronous connections instead of sharing this pool.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# The database is remote, so a probe that cannot reach it must fail fast
# rather than hang a startup or a test session.
DB_CONNECT_TIMEOUT_SECONDS=3

# Timezone every bar timestamp is normalized to. Do not change casually —
# the engine assumes NY-zoned data end to end.
MARKET_TIMEZONE=America/New_York


# -----------------------------------------------------------------------------
# Run pipeline
# -----------------------------------------------------------------------------
# An event-mode backtest is minutes of single-core CPU, so concurrency is
# bounded by cores rather than by request volume.
MAX_CONCURRENT_RUNS=2
MAX_BACKTEST_WINDOW_DAYS=1825

# Minimum seconds between progress/cancellation round trips from a worker.
PROGRESS_WRITE_INTERVAL_SECONDS=1.0

# Worker liveness. A running run beats every INTERVAL seconds on a thread that
# does not depend on engine progress; at boot the reconciler fails only runs
# whose last beat is older than STALE seconds, so one server restarting never
# kills another server's in-flight work.
RUN_HEARTBEAT_INTERVAL_SECONDS=5.0
RUN_HEARTBEAT_STALE_SECONDS=90.0


# -----------------------------------------------------------------------------
# User-strategy validation
# -----------------------------------------------------------------------------
# An uploaded strategy is proven by running a real (small) backtest on it.
VALIDATION_TIMEOUT_SECONDS=600
VALIDATION_WINDOW_DAYS=30
VALIDATION_INITIAL_CAPITAL=100000


# -----------------------------------------------------------------------------
# Storage locations
# -----------------------------------------------------------------------------
# Relative paths resolve against the repository root, not the working
# directory. All three are gitignored and created on demand.
ARTIFACT_DIR=.artifacts
MARKET_CACHE_DIR=data/backfill_cache
STRATEGY_STORE_ROOT=.strategy_store

# `local` writes to STRATEGY_STORE_ROOT. `s3` stores each upload as objects
# under `<prefix>strategies/<id>/` in the bucket below, which must already
# exist (MQS_AWS_INFRA provisions it; this code never creates buckets). With
# `s3`, the bucket name is mandatory and the app refuses to build the store
# without it. The task role needs s3:ListBucket on the bucket and
# s3:GetObject / s3:PutObject / s3:DeleteObject on its strategy objects.
# Production IAM is restricted to `production/strategies/*`.
STRATEGY_STORE_BACKEND=local
STRATEGY_STORE_S3_BUCKET=
# Use `development` locally, `production` in the production ECS task.
# Example: `development/strategies/<id>/strategy.py`.
STRATEGY_STORE_S3_PREFIX=
# Optional: point the S3 client at LocalStack/MinIO for a local end-to-end
# check (path-style addressing is switched on automatically). Leave blank for
# real S3. AWS_ENDPOINT_URL is accepted as a fallback spelling.
STRATEGY_STORE_S3_ENDPOINT_URL=
# Region for the S3 client. Fargate injects AWS_REGION; the infra default is
# us-east-2. Blank lets the SDK use ~/.aws/config. AWS_DEFAULT_REGION is
# accepted as a fallback.
# AWS_REGION=us-east-2
#
# There are deliberately no AWS credential keys here. The SDK's default chain
# supplies them — the ECS task role in a deploy, `aws configure` locally —
# and access keys must never live in .env.


# -----------------------------------------------------------------------------
# Reserved — authentication (not read by this codebase)
# -----------------------------------------------------------------------------
# Auth is built by a parallel session against Supabase. Nothing here is loaded
# by `src/core/config.py` today; the keys are listed so the two sessions agree
# on names when that work lands. Uncomment when it does.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PROJECT_REF=
# SUPABASE_ANON_KEY=
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# JWT_ALGORITHM=RS256
# JWT_AUDIENCE=authenticated
# JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# JWKS_CACHE_TTL_SECONDS=3600
