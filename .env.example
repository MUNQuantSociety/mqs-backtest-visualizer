# =============================================================================
# MQS Backtest Visualizer — Backend environment template
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env
#
# Every variable below should be read through `src/core/config.py` (pydantic
# BaseSettings) — no module should call os.environ directly.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=mqs-backtest-visualizer
APP_ENV=development                  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# PostgreSQL — one instance, two roles for it
# -----------------------------------------------------------------------------
# The MQS database. This application uses it for two distinct things:
#   1. READ  public.market_data          — OHLCV bars the engine simulates over
#   2. WRITE app.* (its own schema)      — runs, metrics, equity points, trades
# The app schema is created on first startup. The trading tables
# (positions_book, cash_equity_book, trade_execution_logs, ...) are NEVER
# touched — not read, not written. Enforced by code review until a dedicated
# restricted role exists.
POSTGRES_HOST=
POSTGRES_PORT=25060
POSTGRES_DB=mqsdb
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Timezone every bar timestamp is normalized to. Do not change casually —
# the engine assumes NY-zoned data end to end.
MARKET_TIMEZONE=America/New_York


# -----------------------------------------------------------------------------
# Authentication (Supabase as identity provider, JWT verified here)
# -----------------------------------------------------------------------------
# Supabase issues the token; this backend verifies it against the public JWKS.
# Verification is offline — no request to Supabase on the hot path.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

JWT_ALGORITHM=RS256                  # prefer asymmetric keys over a shared HS256 secret
JWT_AUDIENCE=authenticated
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
JWKS_CACHE_TTL_SECONDS=3600


# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
MAX_CONCURRENT_RUNS_PER_USER=3
MAX_BACKTEST_WINDOW_DAYS=1825
RATE_LIMIT_PER_MINUTE=60


# -----------------------------------------------------------------------------
# External data APIs
# -----------------------------------------------------------------------------
# Financial Modeling Prep — only needed if the engine backfills on demand.
FMP_API_KEY=
