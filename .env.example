# =============================================================================
# MQS Backtest Visualizer — Backend environment template
# =============================================================================
# Copy to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env
#
# Every variable below should be read through `src/core/config.py` (pydantic
# BaseSettings) — no module should call os.environ directly.
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=mqs-backtest-visualizer
APP_ENV=development                  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Comma-separated origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# Application database (PostgreSQL) — the `app` schema
# --------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Market data source (read-only)
# -----------------------------------------------------------------------------
# The engine reads OHLCV bars from the MQS market_data tables. Point this at a
# read-only role — the visualizer must never write to trading tables.
MARKET_DATA_HOST=
MARKET_DATA_PORT=5432
MARKET_DATA_DB=
MARKET_DATA_USER=
MARKET_DATA_PASSWORD=
MARKET_DATA_SSLMODE=prefer

# Timezone every bar timestamp is normalized to. Do not change casually —
# the engine assumes NY-zoned data end to end.
MARKET_TIMEZONE=America/New_York


# -----------------------------------------------------------------------------
# Authentication (Supabase as identity provider, JWT verified here)
# -----------------------------------------------------------------------------
# Supabase issues the token; this backend verifies it against the public JWKS.
# No Supabase Postgres is used — application data lives in POSTGRES_* above.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

JWT_ALGORITHM=RS256                  # prefer asymmetric keys over a shared HS256 secret
JWT_AUDIENCE=authenticated
JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
JWKS_CACHE_TTL_SECONDS=3600


# -----------------------------------------------------------------------------
# Limits
# -----------------------------------------------------------------------------
MAX_CONCURRENT_RUNS_PER_USER=3
MAX_BACKTEST_WINDOW_DAYS=1825
RATE_LIMIT_PER_MINUTE=60


FMP_API_KEY=
